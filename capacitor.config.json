{
  "appId": "app.aue",
  "appName": "auê",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "includePlugins": [
      "@capacitor-community/apple-sign-in",
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/local-notifications",
      "@capacitor/push-notifications",
      "@capacitor/status-bar",
      "@capgo/capacitor-updater"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#14081E",
      "showSpinner": false,
      "androidSpinnerStyle": "small",
      "spinnerColor": "#FF2BD6"
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "updateUrl": "https://reroot-production.up.railway.app/updates/check",
      "statsUrl": "",
      "allowModifyUrl": true,
      "appReadyTimeout": 15000,
      "responseTimeout": 30,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    }
  }
}
