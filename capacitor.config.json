{
  "appId": "app.aue",
  "appName": "auê",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "includePlugins": [
      "@capacitor-community/apple-sign-in",
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/local-notifications",
      "@capacitor/push-notifications",
      "@capacitor/status-bar",
      "@capgo/capacitor-updater"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#FAF9F6",
      "showSpinner": false,
      "androidSpinnerStyle": "small",
      "spinnerColor": "#7A9E7E"
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "updateUrl": "https://reroot-production.up.railway.app/updates/check",
      "statsUrl": "",
      "allowModifyUrl": true,
      "appReadyTimeout": 15000,
      "responseTimeout": 30,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
