<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>auê</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Purpose strings for the capabilities the WEBVIEW reaches for.
	     These are native-only (Info.plist is compiled into the binary),
	     so they cannot be added by a live update — they have to ride a
	     build, which is why they are going in now.

	     Camera: the event-photo <input type="file"> offers "Take Photo"
	     in WKWebView's picker. iOS TERMINATES the app when that is tapped
	     and NSCameraUsageDescription is absent — a crash on a normal tap
	     in the shipped build, not a degraded feature.

	     Photo library: WKWebView uses PHPicker on modern iOS, which does
	     not strictly require this, but the key is free and covers the
	     UIImagePickerController path on older routes.

	     Location: EventsMap's "usar minha localização" calls
	     navigator.geolocation, which WKWebView refuses outright without
	     this key. -->
	<key>NSCameraUsageDescription</key>
	<string>Pra tirar foto do evento na hora e usar como capa.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pra escolher uma foto da sua galeria como capa do evento.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Pra mostrar no mapa os eventos perto de você.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.511485926685-irun1c38rluvso37l9lqhbh03e35gms5</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
