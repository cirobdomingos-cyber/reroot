# Anthropic — required for Claude event enrichment
ANTHROPIC_API_KEY=sk-ant-...

# Apify — required for Instagram scraping (the only event source now)
APIFY_API_TOKEN=apify_api_...

# App settings
CITY=Curitiba

# Refresh runs daily at 14:00 America/Sao_Paulo (cron, hardcoded). On boot,
# an immediate run only fires if the last refresh is >24h old — protects
# Anthropic + Apify quotas against deploy-induced re-scrapes.

# Railway injects PORT automatically — do not set manually in Railway
# PORT=8000
