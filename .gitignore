node_modules
dist/
output/
.env
.env.*
!.env.example
.claude/
__pycache__/
*.pyc
*.db
.idea/

# Android / TWA build artifacts. Scoped to /android/ so the rules don't
# also catch case-insensitive matches inside /ios/App/ (which has a
# subfolder also named App/ — bare `app/` was hitting it on Windows
# and quietly excluding iOS source files like Info.plist and
# App.entitlements).
/android/.gradle/
/android/build/
/android/app/
/android/gradle/
/android/gradlew
/android/gradlew.bat
/android/build.gradle
/android/settings.gradle
/android/gradle.properties

# Signing keys — NEVER commit
*.keystore
android.keystore
# VAPID / Web Push keys — generated locally, set in Railway env vars only
*.pem

# TWA generated
twa-manifest.json
manifest-checksum.txt
store_icon.png

# VitePWA dev-mode build artifacts — generated on every `npm run dev`
# and regenerated on every config change. Never useful in git.
dev-dist/

# Local design references / handed-off mocks — keep on disk for
# reference, don't ship to the repo.
neon_boteco_rebrand/
