# Anthropic — required for Claude event enrichment
ANTHROPIC_API_KEY=sk-ant-...

# Sympla — https://developers.sympla.com.br (free, create an account)
SYMPLA_TOKEN=

# Eventbrite — https://www.eventbrite.com/platform/api (free)
EVENTBRITE_TOKEN=

# App settings
CITY=Curitiba
REFRESH_INTERVAL_HOURS=6

# Railway injects PORT automatically — do not set manually in Railway
# PORT=8000
